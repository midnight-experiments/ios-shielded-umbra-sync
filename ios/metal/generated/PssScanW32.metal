#undef TABLE_POINT
#undef X_AT
#undef Y_AT
#undef Z_AT
#undef FLAGS_AT
#undef FLAG_VALID
#undef FLAG_IDENTITY
#undef FE_WORDS
#undef M
#undef PINV
#undef P0
#undef P1
